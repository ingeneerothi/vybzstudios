{
  "name": "oscan-intro",
  "version": "1.0.0",
  "private": true,
  "description": "Vidéo motion design de présentation de la marque Oscan (Made in Djassa) — Remotion",
  "scripts": {
    "preview": "remotion preview",
    "studio": "remotion studio",
    "assets": "python3 scripts/extract_assets.py && node scripts/trace_lineart.mjs",
    "still": "remotion still OscanIntro out/still.png",
    "render": "remotion render OscanIntro out/oscan-presentation.mp4 --codec=h264 --crf=18 --x264-preset=slow --color-space=bt709 --audio-bitrate=320k",
    "render:4k": "remotion render OscanIntro out/oscan-presentation-4k.mp4 --codec=h264 --crf=20 --color-space=bt709 --audio-bitrate=320k --scale=2",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/luckiest-guy": "5.3.0",
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "@remotion/paths": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.536",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "potrace": "2.1.8",
    "typescript": "5.9.3"
  }
}
