# Copier en .env puis remplir. Ne jamais committer le vrai .env.

# Serveur
PORT=3000
# URL publique HTTPS du site (sert aux retours de paiement et aux webhooks)
PUBLIC_URL=https://www.exemple-cutandcare.ci
# Fichier de stockage des réservations (JSON)
BOOKINGS_FILE=server/data/bookings.json
# Nombre de proxies devant Node (0 en local, 1 derrière Render / Railway / Nginx)
TRUST_PROXY=0
# Jeton d'accès à la page /admin?token=...  (longue chaîne aléatoire)
ADMIN_TOKEN=

# Paiement démo (simulateur, aucun argent ne circule) : true / false
# Laisser vide : actif automatiquement tant qu'aucun moyen de paiement n'est configuré
DEMO_PAYMENTS=

# ——— Wave Business (API Checkout) ———
# Clé API Checkout (portail Wave Business → Développeurs)
WAVE_API_KEY=
# Secret de signature du webhook « checkout.session.completed »
WAVE_WEBHOOK_SECRET=

# ——— Orange Money Web Payment (developer.orange.com) ———
# En-tête d'autorisation fourni par Orange : « Basic xxxxx »
ORANGE_AUTH_HEADER=
# Merchant key fournie après validation du compte marchand
ORANGE_MERCHANT_KEY=
# dev = bac à sable (devise OUV) ; live = production (devise XOF)
ORANGE_ENV=dev
# Code pays de l'API en production (ci = Côte d'Ivoire)
ORANGE_COUNTRY=ci
