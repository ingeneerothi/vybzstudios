# Copier ce fichier en .env.local puis remplir avec les valeurs de Supabase
# (Supabase > Project Settings > API Keys). Sans ces deux lignes, le site tourne en mode démo.

# URL du projet, ex. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique : « Publishable key » (sb_publishable_...) ou « anon public » sur les anciens projets.
# Jamais la clé secrète / service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse du site en ligne (pour les liens de partage), ex. https://vertical-store.vercel.app
NEXT_PUBLIC_SITE_URL=

# Commande envoyée au vendeur avec la photo, par l'API WhatsApp Business (MISE-EN-LIGNE.md, étape 5).
# Secrets : jamais de NEXT_PUBLIC_ devant. Sans ces deux lignes, le client envoie la photo lui-même s'il le peut.
WHATSAPP_JETON=
WHATSAPP_NUMERO_ID=
# Facultatif : nom et langue du modèle approuvé chez Meta (par défaut nouvelle_commande, fr).
# WHATSAPP_MODELE=nouvelle_commande
# WHATSAPP_LANGUE=fr
